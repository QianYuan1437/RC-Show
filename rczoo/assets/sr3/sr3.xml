<!-- RC Zoo: torque-controlled variant (motors with the URDF effort limits) with a 60 mm probe tool on the flange:
     TCP and a spherical contact probe at its tip, a 6-axis force/torque sensor (site "ft") on the probe body.
     ROKAE xMate SR3 (SR3-C), converted from RokaeRobot/rokae_ros2 rokae_description/urdf/xMateSR3.urdf.xacro
     (Apache-2.0, see LICENSE) with MuJoCo's URDF importer. Changes: visual/collision geom classes, a TCP site at the
     flange (link6 origin), position-PD actuators with the URDF effort limits, contacts disabled (IK benchmarks are
     collision-agnostic), a "home" keyframe = the SDK examples' drag pose {0, pi/6, -pi/2, 0, -pi/3, 0}.
     Joint limits are the URDF's (+-175 deg on joints 1, 4, 5, 6), narrower than the SR3-C datasheet (+-360 deg). -->
<mujoco model="xMateSR3">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast">
    <flag contact="disable"/>
  </option>

  <default>
    <default class="sr3">
      <joint armature="0.05" damping="0.5"/>
      <motor/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" contype="0" conaffinity="0"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="white" rgba="0.94 0.94 0.94 1"/>
    <material name="base_grey" rgba="0.62 0.64 0.66 1"/>
    <material name="tool" rgba="0.3 0.32 0.35 1"/>
    <mesh name="xMateSR3_base" file="xMateSR3_base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="xMateSR3_link1" file="xMateSR3_link1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="xMateSR3_link2" file="xMateSR3_link2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="xMateSR3_link3" file="xMateSR3_link3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="xMateSR3_link4" file="xMateSR3_link4.stl" scale="0.001 0.001 0.001"/>
    <mesh name="xMateSR3_link5" file="xMateSR3_link5.stl" scale="0.001 0.001 0.001"/>
    <mesh name="xMateSR3_link6" file="xMateSR3_link6.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <body name="xMateSR3_base" childclass="sr3">
      <geom mesh="xMateSR3_base" class="visual" material="base_grey"/>
      <geom mesh="xMateSR3_base" class="collision"/>
      <body name="xMateSR3_link1" pos="0 0 0.334">
        <inertial pos="1.2e-05 -0.007924 0.248734" quat="0.998623 -0.0524572 7.89616e-05 0.000203315" mass="2.727" diaginertia="0.023985 0.0237521 0.00466782"/>
        <joint name="joint1" range="-3.0543 3.0543"/>
        <geom mesh="xMateSR3_link1" class="visual" material="white"/>
        <geom mesh="xMateSR3_link1" class="collision"/>
        <body name="xMateSR3_link2">
          <inertial pos="0.018501 -0.068862 0.142338" quat="0.985278 -0.0155595 -0.0782844 0.151184" mass="3.179" diaginertia="0.0628399 0.0612929 0.00753726"/>
          <joint name="joint2" range="-2.3562 2.2689" axis="0 1 0"/>
          <geom mesh="xMateSR3_link2" class="visual" material="white"/>
          <geom mesh="xMateSR3_link2" class="collision"/>
          <body name="xMateSR3_link3" pos="0.05 0 0.29">
            <inertial pos="0.025034 0.011526 0.041307" quat="0.908354 0.0140263 -0.201485 -0.366196" mass="1.601" diaginertia="0.0079666 0.00635641 0.00248669"/>
            <joint name="joint3" range="-3.0543 2.3562" axis="0 -1 0"/>
            <geom mesh="xMateSR3_link3" class="visual" material="white"/>
            <geom mesh="xMateSR3_link3" class="collision"/>
            <body name="xMateSR3_link4" pos="-0.05 0 0.29">
              <inertial pos="-2.5e-05 -0.010923 -0.071267" quat="0.997416 -0.0718205 -0.000146365 -0.00164634" mass="1.882" diaginertia="0.0133199 0.0127282 0.00257997"/>
              <joint name="joint4" range="-3.0543 3.0543"/>
              <geom mesh="xMateSR3_link4" class="visual" material="white"/>
              <geom mesh="xMateSR3_link4" class="collision"/>
              <body name="xMateSR3_link5" pos="0 0.136 0">
                <inertial pos="3e-06 0.029173 0.007019" quat="0.620806 0.783963 -0.000826176 -0.000933337" mass="1.507" diaginertia="0.00503264 0.00402289 0.00253631"/>
                <joint name="joint5" range="-3.0543 3.0543" axis="0 -1 0"/>
                <geom mesh="xMateSR3_link5" class="visual" material="white"/>
                <geom mesh="xMateSR3_link5" class="collision"/>
                <body name="xMateSR3_link6" pos="0 0 0.1035">
                    <geom name="tool_shaft" type="cylinder" size="0.012 0.024" pos="0 0 0.024" class="visual" material="tool"/>
                    <site name="tcp" pos="0 0 0.06" size="0.01" rgba="1 0.3 0.1 1" group="1"/>
                    <body name="probe" pos="0 0 0.06">
                      <inertial mass="0.02" pos="0 0 0" diaginertia="1e-6 1e-6 1e-6"/>
                      <site name="ft" pos="0 0 0" size="0.005" group="4"/>
                      <geom name="probe" type="sphere" size="0.012" contype="2" conaffinity="1" condim="3"
                        friction="0.3 0.005 0.0001" rgba="1 0.45 0.1 1" group="1"/>
                      <geom name="probe_visual" type="sphere" size="0.012" pos="0 0 0" class="visual" material="tool"/>
                    </body>
                  <inertial pos="7.3e-05 7.9e-05 -0.044853" quat="0.62063 0.000239921 -0.00162941 0.784102" mass="0.634" diaginertia="0.00100286 0.000996696 0.000447944"/>
                  <joint name="joint6" range="-3.0543 3.0543"/>
                  <geom mesh="xMateSR3_link6" class="visual" material="white"/>
                  <geom mesh="xMateSR3_link6" class="collision"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    </worldbody>

  <actuator>
    <motor class="sr3" name="motor1" joint="joint1" ctrlrange="-66 66"/>
    <motor class="sr3" name="motor2" joint="joint2" ctrlrange="-66 66"/>
    <motor class="sr3" name="motor3" joint="joint3" ctrlrange="-29 29"/>
    <motor class="sr3" name="motor4" joint="joint4" ctrlrange="-16 16"/>
    <motor class="sr3" name="motor5" joint="joint5" ctrlrange="-16 16"/>
    <motor class="sr3" name="motor6" joint="joint6" ctrlrange="-16 16"/>
  </actuator>

  <sensor>
    <force name="ft_force" site="ft"/>
    <torque name="ft_torque" site="ft"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="0 0.5235988 -1.5707963 0 -1.0471976 0"/>
  </keyframe>
</mujoco>
